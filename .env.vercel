# =============================================================================
# APPRAISE-AI — Vercel Deployment Environment Variables
# Add these in Vercel Dashboard > Settings > Environment Variables
# =============================================================================

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Found in Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key (server-only, never exposed to browser):
# Found in Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Found in Supabase Dashboard > Settings > Database > Connection string
# Use the "URI" format, e.g.:
# postgresql://postgres.xxx:yyyy@aws-0-xxx.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://POSTGRES_PASSWORD@HOST:6543/postgres

# ── Auth Secret ───────────────────────────────────────────────────────────────
# Random secret for signing JWT session cookies (min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET=your-32-plus-character-random-secret-here

# ── App URL ──────────────────────────────────────────────────────────────────────
# Your Vercel deployment URL, e.g. https://appraise-ai.vercel.app
APP_BASE_URL=https://your-app.vercel.app

# ── AI Provider — Anthropic Claude (sole LLM provider) ─────────────────────
# Powers the appraisal analysis (Opus 4.7), photo vision, web research,
# and persuasion brief generation.
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────────
# Found in Stripe Dashboard > Developers > API keys > secret key
STRIPE_SECRET_KEY=sk_live_...

# Found in Stripe Dashboard > Developers > Webhooks > endpoint secrets
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Letter Mailing (Lob) ─────────────────────────────────────────────────────
# Found in Lob Dashboard > Settings > API Keys
LOB_API_KEY=

# ── Property Data Providers ───────────────────────────────────────────────────
# Get keys from respective services:
# LightBox: https://www.lightboxre.com/developers/
# RentCast: https://rentcast.io/account/api
# Regrid: https://www.regrid.com/people-api
# ATTOM: https://api.rapi.attomdata.com/
LIGHTBOX_API_KEY=
RENTCAST_API_KEY=
REGRID_API_KEY=
ATTOM_API_KEY=

# ── Address Autocomplete & Google Maps ───────────────────────────────────
# Create at console.cloud.google.com — enable Places API (New) + Maps JavaScript API
# Restrict key to your Vercel domains
# Server-side key (Places autocomplete, Geocoding):
GOOGLE_MAPS_API_KEY=
# Client-side key (Google Maps JavaScript API — map rendering in the browser):
VITE_GOOGLE_MAPS_API_KEY=

# ── AWS S3 (File Storage) ─────────────────────────────────────────────────────
# Required for property photo uploads and report PDF storage
# Found in AWS IAM > Users > access keys, or from .env.local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 bucket name (create in AWS S3 > Create bucket)
S3_BUCKET=appraise-ai-uploads
# AWS region (e.g. us-east-1)
AWS_REGION=us-east-1

# =============================================================================
# DEVELOPMENT-ONLY (do NOT set in Vercel production)
# =============================================================================
# NODE_ENV=development
# PORT=3000

# ── Email Delivery (Resend) ───────────────────────────────────────────────────
# Used for: analysis confirmations, report-ready emails, filing confirmations,
# emailed appeal filings (counties that accept email intake).
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Default From address (must be a domain verified in Resend)
EMAIL_FROM=AppraiseAI <noreply@appraise-ai.com>
# Set to "1" to disable real sending and only log (useful for testing)
# EMAIL_DELIVERY_STUB=1

# ── Vercel Cron Authentication ────────────────────────────────────────────────
# Required for /api/cron?task=... Vercel attaches this as
#   Authorization: Bearer ${CRON_SECRET}
# on every scheduled cron invocation.
# Generate: openssl rand -base64 32
CRON_SECRET=your-32-plus-character-random-secret-here
