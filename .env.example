# Core runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@host:5432/appraise_ai
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider — Anthropic Claude (sole LLM provider)
ANTHROPIC_API_KEY=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Letter mailing
LOB_API_KEY=

# Property data providers
LIGHTBOX_API_KEY=
RENTCAST_API_KEY=
REGRID_API_KEY=
ATTOM_API_KEY=

# Address autocomplete (server-side)
# Canonical key name; GOOGLE_MAPS_PLATFORM_API_KEY is accepted as a legacy alias.
GOOGLE_MAPS_API_KEY=
# Provider: "google" (default), "mapbox", or "photon" (OSM, no key required)
ADDRESS_AUTOCOMPLETE_PROVIDER=google
MAPBOX_ACCESS_TOKEN=

# Google Maps JavaScript API (client-side map rendering)
VITE_GOOGLE_MAPS_API_KEY=

# Google Custom Search Engine (optional — for web research enhancement)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=appraise-ai-uploads
AWS_REGION=us-east-1

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Operational toggles (optional)
ALLOW_DRAFT_RECIPES=0
EMAIL_DELIVERY_STUB=0
LOB_STUB=0
FILING_ARTIFACT_RETENTION_DAYS=365
