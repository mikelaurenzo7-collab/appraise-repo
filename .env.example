# Core runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@host:5432/appraise_ai
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# AI Providers — Gemini & Anthropic (replaces Manus Forge)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Letter mailing
LOB_API_KEY=

# Property data providers
LIGHTBOX_API_KEY=
RENTCAST_API_KEY=
REGRID_API_KEY=
ATTOM_API_KEY=

# Address autocomplete
MAPBOX_ACCESS_TOKEN=

# AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=appraise-ai-uploads
AWS_REGION=us-east-1
ADDRESS_AUTOCOMPLETE_PROVIDER=photon
MAPBOX_ACCESS_TOKEN=

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Operational toggles (optional)
ALLOW_DRAFT_RECIPES=0
EMAIL_DELIVERY_STUB=0
LOB_STUB=0
FILING_ARTIFACT_RETENTION_DAYS=365
