{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    { "source": "/api/cron(.*)", "destination": "/api/cron" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron?task=process-analysis", "schedule": "*/2 * * * *" },
    { "path": "/api/cron?task=process-reports", "schedule": "*/2 * * * *" },
    { "path": "/api/cron?task=process-filings", "schedule": "*/5 * * * *" },
    { "path": "/api/cron?task=lob-reconcile", "schedule": "*/30 * * * *" },
    { "path": "/api/cron?task=cleanup-reports", "schedule": "0 * * * *" },
    { "path": "/api/cron?task=cleanup-filings", "schedule": "0 3 * * *" },
    { "path": "/api/cron?task=deadline-reminders", "schedule": "0 14 * * *" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
